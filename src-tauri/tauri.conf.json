{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCanvas",
  "version": "0.2.0",
  "identifier": "com.embo.deskcanvas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskCanvas",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Embo",
    "shortDescription": "Diseña tu fondo de pantalla con los iconos reales del escritorio",
    "category": "GraphicsAndDesign",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
